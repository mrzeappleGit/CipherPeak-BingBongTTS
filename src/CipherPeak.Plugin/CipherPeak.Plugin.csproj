<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CipherPeak.BingBongTTS</AssemblyName>
    <RootNamespace>CipherPeak.Plugin</RootNamespace>
    <!-- The game supplies UnityEngine/Photon/Assembly-CSharp at runtime. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CipherPeak.Core\CipherPeak.Core.csproj" />
  </ItemGroup>

  <Target Name="CheckPeakDir" BeforeTargets="BeforeBuild" Condition="!Exists('$(PeakManagedDir)')">
    <Error Text="Could not find the PEAK install. Set it explicitly, e.g. dotnet build -p:PeakDir=&quot;D:\SteamLibrary\steamapps\common\PEAK&quot;, or set the PEAK_DIR environment variable. (Looked for '$(PeakManagedDir)'.)" />
  </Target>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(PeakManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule">
      <HintPath>$(PeakManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(PeakManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(PeakManagedDir)\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(PeakManagedDir)\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(PeakManagedDir)\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Zorro.Core.Runtime">
      <HintPath>$(PeakManagedDir)\Zorro.Core.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The options-screen slider: the settings framework, and float2 for its min/max. -->
    <Reference Include="Zorro.Settings.Runtime">
      <HintPath>$(PeakManagedDir)\Zorro.Settings.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <HintPath>$(PeakManagedDir)\Unity.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Rewriting the cloned slot's number label. TMP_Text derives from UnityEngine.UI's
         MaskableGraphic, so the UI assembly comes along whether we want it or not. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(PeakManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(PeakManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ItemDatabase derives from an Odin-serialized base type. -->
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(PeakManagedDir)\Sirenix.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Sirenix.OdinInspector.Attributes">
      <HintPath>$(PeakManagedDir)\Sirenix.OdinInspector.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
